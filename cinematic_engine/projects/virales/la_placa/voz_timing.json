[
 {
  "text": "Este policía se jubilaba mañana.",
  "start": 0.13,
  "end": 2.02
 },
 {
  "text": "Pero esta noche persiguió al coche equivocado.",
  "start": 2.2399999999999998,
  "end": 4.490000000000001
 },
 {
  "text": "Tres minutos antes.",
  "start": 4.71,
  "end": 5.9799999999999995
 },
 {
  "text": "Un deportivo rojo. Sin matrícula.",
  "start": 6.2,
  "end": 7.989999999999999
 },
 {
  "text": "A doscientos por hora en plena avenida.",
  "start": 8.209999999999999,
  "end": 9.979999999999999
 },
 {
  "text": "Él lo vio pasar. Y arrancó.",
  "start": 10.2,
  "end": 11.639999999999999
 },
 {
  "text": "Su compañero le gritó: ¡déjalo!",
  "start": 11.86,
  "end": 13.46
 },
 {
  "text": "No lo dejó.",
  "start": 13.68,
  "end": 14.17
 },
 {
  "text": "Entonces el deportivo hizo algo imposible.",
  "start": 14.389999999999999,
  "end": 16.75
 },
 {
  "text": "Giró. Sin frenar.",
  "start": 16.97,
  "end": 18.319999999999997
 },
 {
  "text": "Él no pudo.",
  "start": 18.54,
  "end": 19.060000000000002
 },
 {
  "text": "Cuando llegaron los refuerzos, el deportivo ya no estaba.",
  "start": 19.28002083333333,
  "end": 22.19002083333333
 },
 {
  "text": "Solo encontraron una placa de policía en el asfalto.",
  "start": 22.41002083333333,
  "end": 24.89002083333333
 },
 {
  "text": "Con su nombre.",
  "start": 25.31002083333333,
  "end": 26.01002083333333
 },
 {
  "text": "Pero él todavía llevaba la suya puesta.",
  "start": 26.23002083333333,
  "end": 28.330020833333332
 },
 {
  "text": "¿Quién conducía el deportivo?",
  "start": 28.55002083333333,
  "end": 29.740020833333336
 }
]